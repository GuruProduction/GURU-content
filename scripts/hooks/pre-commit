# THE PUBLISH GATE.
#
# Refuses a commit that edits published content by hand. Every file in prompts/,
# skills/, tools/, agents/ and packs/ is generated by scripts/publish.mjs from
# the live database, so a human edit there is a change that will be silently
# erased by the next publish and that nobody will have decided.
#
# HOW IT DECIDES. It looks at what is staged. A commit that stages content files
# AND the manifest is a publish, because the publisher writes both together. A
# commit that stages content files without the manifest is a hand edit, because
# the publisher can never produce that state.
#
# WHY A GATE AND NOT A DOCUMENTED RULE. The rule was written down in lux.md and
# still would have been broken, because the person most likely to break it is a
# fresh session that has not read lux.md yet. A rule that is not executable is
# not a rule; that is why the app repo has a privacy gate rather than a
# paragraph telling people not to commit addresses.

staged=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$staged" ]; then
  exit 0
fi

content_touched=$(echo "$staged" | grep -E '^(prompts|skills|tools|agents|packs)/' || true)
manifest_touched=$(echo "$staged" | grep -E '^manifest\.json$' || true)

if [ -n "$content_touched" ] && [ -z "$manifest_touched" ]; then
  echo "" >&2
  echo "publish gate: REFUSED" >&2
  echo "" >&2
  echo "Content files are staged without manifest.json, which only a hand edit can" >&2
  echo "produce. This repo is generated from the live database:" >&2
  echo "" >&2
  echo "    node scripts/publish.mjs" >&2
  echo "    git add -A && git commit" >&2
  echo "" >&2
  echo "If you are changing a prompt, do it in the superadmin panel, publish, and" >&2
  echo "commit the result. If the database is unavailable, the edit waits." >&2
  echo "" >&2
  echo "Files staged:" >&2
  echo "$content_touched" | head -20 | sed 's/^/  /' >&2
  echo "" >&2
  exit 1
fi

exit 0
